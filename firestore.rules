rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────── helpers ─────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isBot() {
      return isSignedIn()
        && request.auth.uid == 'SuTqNzX5A5hwmDnMh7wCK4aHEss1';
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // ────────── Contenido del briefing (gated por email/login) ──────────
    // Cualquier signed-in (anónimo o admin) puede leer. Solo bot/admin escribe.

    match /briefings/{date} {
      allow read: if isSignedIn();
      allow write: if isBot() || isAdmin();
    }

    match /businessIdeas/{id} {
      allow read: if isSignedIn();
      allow write: if isBot() || isAdmin();
    }

    match /aiTips/{id} {
      allow read: if isSignedIn();
      allow write: if isBot() || isAdmin();
    }

    match /rustTasks/{id} {
      allow read: if isSignedIn();
      allow write: if isBot() || isAdmin();
    }

    match /rustReadings/{id} {
      allow read: if isSignedIn();
      allow write: if isBot() || isAdmin();
    }

    match /agentItems/{id} {
      allow read: if isSignedIn();
      allow write: if isBot() || isAdmin();
    }

    // ────────── Articles (P1.2 — SEO long-form, lectura pública) ──────────
    // Lectura abierta para crawlers cuando published == true.
    // Drafts (published == false) solo visibles para bot/admin.

    // ────────── Cola de artículos pendientes (input para la rutina) ──────────
    // Admin crea/edita/borra. Bot solo lee y actualiza status (no crea ni borra).
    // Cero acceso público.

    match /pendingArticles/{id} {
      allow read:   if isAdmin() || isBot();
      allow create: if isAdmin();
      allow update: if isAdmin() || isBot();
      allow delete: if isAdmin();
    }

    match /articles/{slug} {
      // Split into multiple allow clauses so Firestore's evaluator can prove
      // unconditional access for admin/bot LIST queries without requiring
      // a matching where() clause from the client.
      allow read: if isAdmin() || isBot();
      allow read: if resource != null && resource.data.published == true;

      allow create: if (isBot() || isAdmin())
                    && request.resource.data.slug is string
                    && request.resource.data.title is string
                    && request.resource.data.published is bool;
      allow update, delete: if isBot() || isAdmin();
    }

    match /articleEngagement/{id} {
      allow read: if isAdmin() || isBot();

      allow create: if isSignedIn()
                    && request.resource.data.visitorId is string
                    && request.resource.data.articleSlug is string
                    && request.resource.data.sessionId is string
                    && request.resource.data.viewCount is int
                    && request.resource.data.activeSeconds is int;

      allow update: if isSignedIn()
                    && resource.data.visitorId == request.resource.data.visitorId
                    && resource.data.articleSlug == request.resource.data.articleSlug;

      allow delete: if isAdmin();
    }

    match /crmEvents/{id} {
      allow read: if isAdmin() || isBot();

      allow create: if isSignedIn()
                    && request.resource.data.eventId is string
                    && request.resource.data.eventType is string
                    && request.resource.data.visitorId is string
                    && request.resource.data.sessionId is string
                    && request.resource.data.pagePath is string
                    && request.resource.data.pageType is string;

      allow update: if false;
      allow delete: if isAdmin();
    }

    match /leadProfiles/{id} {
      allow read: if isAdmin() || isBot();
      allow write: if isAdmin() || isBot();
    }

    match /journeySummaries/{id} {
      allow read: if isAdmin() || isBot();
      allow write: if isAdmin() || isBot();
    }

    // ────────── Captura de leads (visitors) ──────────
    // Doc ID = email lowercased. Cada visitante crea/actualiza solo su doc.
    // Admin lee toda la colección. P0.4 agrega source/utmMedium/utmCampaign.

    match /visitors/{email} {
      allow read: if isAdmin();

      // Cualquier signed-in puede crear con su uid actual.
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200;

      // El uid de anonymous cambia entre sessions, por eso el update no lo exige.
      // Se valida que el email del doc no cambie y que el campo uid sea el del caller.
      allow update: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == resource.data.email;

      allow delete: if isAdmin();
    }

    // ────────── Lead scoring (P2.3 — preparado para futuro) ──────────
    match /leads/{email} {
      allow read, write: if isAdmin();
    }
  }
}
